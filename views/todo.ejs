<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Todo App</title>
    <style>
        .completed {
            text-decoration: line-through;
        }
    </style>
</head>

<body>

    <h2>My Todo List</h2>

    <ul>
        <% if (todos.length === 0) { %>
            <li>No tasks added yet!</li>
        <% } %>

        <% for(let i = 0; i < todos.length; i++){ %>
            <li>
                <form action="/todo/toggle" method="POST">
                    <input type="hidden" name="id" value="<%= todos[i].id %>" />
                    
                    <input type="checkbox" onchange="this.form.submit()" <%= todos[i].completed ? 'checked' : '' %> />

                    <span class="<%= todos[i].completed ? 'completed' : '' %>">
                        <%= todos[i].text %>
                    </span>
                </form>
            </li>
        <% } %>
    </ul>

    <a href="/form">+ Add New Todo</a>

</body>

</html>